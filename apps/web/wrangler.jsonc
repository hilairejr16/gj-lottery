{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gj-lottery",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Enable Workers Logs so errors are visible in the Cloudflare dashboard
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // Plain-text build-time variables
  // NEXT_PUBLIC_ vars must be here (not Dashboard Secrets) so they are inlined at build time
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://gj-lottery.hilaire16.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://avtquvinozqogeskbjyd.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF2dHF1dmlub3pxb2dlc2tianlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg0NTI3NTksImV4cCI6MjA5NDAyODc1OX0.LUpxmwJqkuD6o44JAhn2ec5TqzAmhWxGdXrtChmbbh8"
  }
}
